# ==============================================================================
# CONFIGURAÇÃO NGINX PARA KLYNNER PRO (klynner.com.br)
# Local sugerido no Ubuntu: /etc/nginx/sites-available/klynner.com.br
# Ativar com: sudo ln -s /etc/nginx/sites-available/klynner.com.br /etc/nginx/sites-enabled/
# ==============================================================================

server {
    listen 80;
    listen [::]:80;
    server_name klynner.com.br www.klynner.com.br;

    # Limite máximo de upload para suportar arquivos PDF grandes (essencial para o Klynner PRO)
    client_max_body_size 500M;

    # Timeouts estendidos para operações pesadas de merge / conversão
    proxy_connect_timeout 300s;
    proxy_send_timeout 300s;
    proxy_read_timeout 300s;
    send_timeout 300s;

    location / {
        # Encaminha para a aplicação Klynner rodando na porta local 8000
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;

        # Headers necessários para preservar IP real, Host e protocolo SSL/HTTPS
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Buffering otimizado para streaming
        proxy_buffering off;
        proxy_request_buffering off;
    }
}
