# =============================================================================
# Klynner Suite - Variáveis de Ambiente & Configurações de E-mail (SMTP)
# =============================================================================

PORT=8000
ADMIN_KEY=klynneradmin

# -----------------------------------------------------------------------------
# Configurações de Envio de E-mails (Respostas aos Comentários e Feedbacks)
# -----------------------------------------------------------------------------
# Exemplo 1: Gmail (Requer gerar uma "Senha de App" em sua Conta Google)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=seu-email@gmail.com
# SMTP_PASSWORD=sua-senha-de-app-de-16-digitos
# SMTP_FROM=Klynner Suite <seu-email@gmail.com>
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false

# Exemplo 2: Servidor Próprio / Hospedagem (cPanel / Titan / Hostinger / Locaweb)
# SMTP_HOST=mail.klynner.com.br
# SMTP_PORT=465
# SMTP_USER=contato@klynner.com.br
# SMTP_PASSWORD=sua_senha_forte
# SMTP_FROM=Klynner Suite <contato@klynner.com.br>
# SMTP_USE_TLS=false
# SMTP_USE_SSL=true

# Exemplo 3: Brevo (Sendinblue) / SendGrid / Resend (Serviço Transacional)
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=seu_login_brevo
# SMTP_PASSWORD=sua_master_key_smtp
# SMTP_FROM=Klynner Suite <contato@klynner.com.br>
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Klynner Suite <contato@klynner.com.br>
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT=15.0
